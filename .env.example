# Isi dengan ID Google Cloud project yang SUDAH terdaftar di Earth Engine.
# Contoh: GOOGLE_CLOUD_PROJECT=rrl-forestwatch-123456
GOOGLE_CLOUD_PROJECT=

# Opsional: peta realtime Copernicus Data Space (Sentinel Hub). Lihat README.
CDSE_INSTANCE_ID=
CDSE_LAYER=S2L2A

# true = pemrosesan statistik otomatis tanggal 10 pukul 04:00 WIB.
# Memerlukan server/aplikasi tetap berjalan pada waktu tersebut.
ENABLE_SCHEDULER=true
